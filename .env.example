# Copie ce fichier en .env.local et remplis les valeurs (ne jamais committer .env.local)

# Clé API Brevo (Settings > SMTP & API > API Keys)
BREVO_API_KEY=

# Identifiants des listes Brevo (Contacts > Lists, l'ID est affiché pour chaque liste)
BREVO_LIST_ID_LAUNCH=
BREVO_LIST_ID_BETA=

# Id du template Brevo « double opt-in » (email de confirmation d'inscription).
# Templates > le numéro est dans l'URL d'édition du template (/templates/email/edit/<id>).
BREVO_DOI_TEMPLATE_ID=

# Adresse qui reçoit les messages du formulaire de contact (/contact).
# Envoyés via Brevo (même BREVO_API_KEY) ; « Répondre » répond directement à l'internaute.
CONTACT_TO_EMAIL=

# Cloudflare Turnstile — anti-robots des formulaires (inscription + contact).
# Cloudflare > Turnstile > Add widget. Si absentes, les formulaires fonctionnent
# sans (seuls le champ piège et le délai minimum protègent). Mettre les DEUX.
# Clés de test publiques (toujours valides) pour le local :
#   1x00000000000000000000AA / 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Supabase — requis par la page /reset-password (changement de mot de passe web).
# Doit pointer sur la MÊME instance que l'app pour l'environnement correspondant :
#   - prod    -> https://prod.sp.laboon-app.com
#   - staging -> https://staging.sp.laboon-app.com
# L'anon key est une clé publique (JWT role "anon"), pas un secret sensible.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
